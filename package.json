{
  "name": "@vitravel/admin",
  "version": "0.1.0",
  "private": true,
  "description": "ViTravel Admin Console — headless Next.js admin for the multi-site travel platform",
  "scripts": {
    "dev": "node scripts/print-dev-url.cjs && next dev --port 3100 --hostname 0.0.0.0",
    "build": "bash scripts/build-prod.sh",
    "start": "next start --port 3100 --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-to-public.cjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/view": "^6.43.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "sass": "^1.89.2",
    "typescript": "^5.8.3"
  }
}
