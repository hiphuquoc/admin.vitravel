# Local / staging HMR (npm run dev)
# Copy → .env.local

ADMIN_API_ORIGIN=https://vitravel.dev
NEXT_PUBLIC_SITE_ORIGIN=https://vitravel.dev
# Fallback khi dự án chưa có domain; mode local/prod suy từ host này (hoặc ép):
# NEXT_PUBLIC_PUBLIC_HOST_MODE=local
NEXT_PUBLIC_API_BASE=https://vitravel.dev/api/v1/admin
NEXT_PUBLIC_APP_NAME=ViTravel Admin
NEXT_PUBLIC_APP_TAGLINE=Hài lòng hơn cả mong đợi

# Không dùng basePath — admin root trên admin.vitravel.* / localhost:3100
# NEXT_PUBLIC_BASE_PATH=

# Tuỳ chọn: same-origin qua Next rewrite (dev) — cần ADMIN_API_ORIGIN
# NEXT_PUBLIC_API_BASE=/api/v1/admin
